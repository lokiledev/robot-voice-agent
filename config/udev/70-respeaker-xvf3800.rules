# Lets the user logged in at the seat ask the reSpeaker XVF3800 where it hears speech from, over
# USB, without root. Install:
#   sudo cp config/udev/70-respeaker-xvf3800.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# On a robot with nobody logged in at a seat, replace TAG+="uaccess" with GROUP="plugdev",
# MODE="0660" and add the robot's user to plugdev.
SUBSYSTEM=="usb", ATTR{idVendor}=="2886", ATTR{idProduct}=="001a", TAG+="uaccess"
